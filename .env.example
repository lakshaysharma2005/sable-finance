# Copy to .env.local and fill in. Never commit .env.local.
# Each person running their own instance should generate their own secrets
# and use their own Neon database + Plaid keys (do not reuse someone else's).

# --- Plaid (https://dashboard.plaid.com/developers/keys) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# --- Database (Neon connection string) ---
DATABASE_URL=

# --- Auth (single password for this instance) ---
# Generate hash: node scripts/hash-password.mjs "your password"
APP_PASSWORD_HASH=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Encrypts Plaid access tokens at rest (generate like SESSION_SECRET) ---
ENCRYPTION_KEY=

# --- Public app URL (local or your Vercel deploy) ---
# Local: http://localhost:3000
# Deployed: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Vercel cron auth (any long random string) ---
CRON_SECRET=

# --- Optional: Kalshi betting balance ---
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY=
# KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
